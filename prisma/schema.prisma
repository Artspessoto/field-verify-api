generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
}

enum AuditStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  FRAUD_SUSPECT
}

model User {
  id                String    @id @default(uuid())
  name              String
  document          String    @unique
  email             String    @unique
  password_hash     String
  role              Role      @default(AGENT)
  is_active         Boolean   @default(true)
  email_verified_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tokens      Token[]
  audits      Audit[] @relation("AgentAudits")
  evaluations Audit[] @relation("SupervisorEvaluations")

  @@map("users")
}

model Token {
  id         String   @id @default(uuid())
  token      String   @unique
  type       String
  expires_at DateTime
  created_at DateTime @default(now())

  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  @@map("tokens")
}

model Merchant {
  id                 String  @id @default(uuid())
  name               String
  address            String?
  tax_identification String  @unique
  latitude           Float
  longitude          Float
  is_active          Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  audits     Audit[]

  @@index([latitude, longitude])
  @@index([tax_identification])
  @@map("merchants")
}

model Audit {
  id     String      @id @default(uuid())
  status AuditStatus @default(PENDING)

  check_in_at  DateTime  @default(now())
  check_out_at DateTime?

  validated_at DateTime?
  updated_at   DateTime  @updatedAt

  check_in_lat  Float
  check_in_long Float

  check_out_lat  Float?
  check_out_long Float?

  user    User   @relation("AgentAudits", fields: [user_id], references: [id])
  user_id String

  supervisor    User?   @relation("SupervisorEvaluations", fields: [supervisor_id], references: [id])
  supervisor_id String?

  merchant    Merchant @relation(fields: [merchant_id], references: [id])
  merchant_id String

  notes             String? //agent report
  supervisor_review String? //supervisor review about agent audit

  photos String[]

  @@index([user_id, check_in_at])
  @@map("audits")
}
